# ========================================================
# TECH AUCTION — ROOT ENVIRONMENT TEMPLATE (.env.example)
# Overview of variables for Server and Client deployment.
# ========================================================

# --- BACKEND SERVER (.env in server/) ---
PORT=3001
NODE_ENV=production
DATABASE_URL=postgresql://user:password@hostname:5432/tech_auction?sslmode=require
DATABASE_SSL=true
JWT_SECRET=generate_a_random_32_char_hex_secret_for_production
JWT_EXPIRES_IN=24h
CLIENT_URL=https://techauction.vercel.app
DOCKER_ENABLED=true
EXECUTION_TIMEOUT=10000
EXECUTION_MEMORY_LIMIT=128m
EXECUTION_CPU_LIMIT=1
# EXECUTION_SERVICE_URL=https://execution.internal.techauction.com
# EXECUTION_SERVICE_TOKEN=internal_secret_token

# --- FRONTEND CLIENT (.env in client/) ---
VITE_API_URL=https://api.techauction.com/api
VITE_SOCKET_URL=https://api.techauction.com
