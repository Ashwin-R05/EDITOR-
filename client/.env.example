# ========================================================
# TECH AUCTION — CLIENT ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env or configure in Vercel / hosting dashboard.
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put private tokens, database strings, or secrets here!
# ========================================================

# Production Backend REST API Base URL
# If deploying frontend and backend under the same domain or proxy, leave as /api
# If backend is on a separate domain (e.g., Render, Railway, VPS):
VITE_API_URL=https://api.techauction.com/api

# Production Socket.IO Server URL
# Must point to the persistent WebSocket backend server (protocol https:// or wss://):
VITE_SOCKET_URL=https://api.techauction.com
