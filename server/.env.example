# ========================================================
# TECH AUCTION — SERVER ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your production values.
# NEVER commit real credentials, passwords, or JWT secrets!
# ========================================================

# Application Port & Mode
PORT=3001
NODE_ENV=production

# --------------------------------------------------------
# Database Configuration (PostgreSQL)
# --------------------------------------------------------
# Standard PostgreSQL Connection String (Recommended for managed DBs: Neon, Supabase, Railway, RDS):
DATABASE_URL=postgresql://username:password@hostname:5432/tech_auction?sslmode=require
DATABASE_SSL=true

# Alternative individual database parameters (if DATABASE_URL is omitted):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tech_auction
# DB_USER=postgres
# DB_PASSWORD=your_secure_db_password

# --------------------------------------------------------
# Authentication (JWT)
# --------------------------------------------------------
# Minimum 32-character high-entropy secret.
# In production, startup fails if JWT_SECRET is unset or default!
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_in_production
JWT_EXPIRES_IN=24h

# --------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# --------------------------------------------------------
# Deployed frontend domain(s). Supports comma-separated origins:
CLIENT_URL=https://techauction.vercel.app,https://yourdomain.com
CORS_ORIGIN=https://techauction.vercel.app

# --------------------------------------------------------
# C Code Execution Sandbox (Docker)
# --------------------------------------------------------
# When hosting on a Docker-capable server/VPS:
DOCKER_ENABLED=true
EXECUTION_TIMEOUT=10000
EXECUTION_MEMORY_LIMIT=128m
EXECUTION_CPU_LIMIT=1

# Optional: If the Docker runner is deployed on a dedicated execution microservice:
# EXECUTION_SERVICE_URL=https://execution.internal.techauction.com
# EXECUTION_SERVICE_TOKEN=your_internal_service_auth_token
